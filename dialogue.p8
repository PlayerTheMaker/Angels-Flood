	},
	
	--lvl 2
	{
	"104|50|i7e1|\ffA sea of \fcWater\n\ffGiven way to sea of\n\f9Magma\ff.",
	"!|.5,2|.35,2|.5,2",
	"104|50|i7e1|\ffAm I to join \fcScrubs\ff\nnow?",
 "!|-.1,2|.15,2|.5,2",
 "30|50|i0g1|Almost... It appears\n\fcScrubs\f7 failed to rid\nus of this bother.",
	"104|50|i7g1|\ffOh no. Does this mean\nyou must take my\n\f7wing\ff?",
	"!|-.1,2|.2,2|.5,2",
	"104|50|i7e1|\ffDo you truly not\ntrust us?",
	"30|50|i0g1|I... trust you, and did\ntrust Scrubs, but it's\nan act of trust...",
	"-|||In me. In our plan to\nmake the world know\npurity again.",
	"!|-.1,2|.15,2|.5,2",
