function copy()
	
	str = ""
	for speech in all(dialogue) do
	 for l in all(speech) do
	 	str = str..l.."#"
  end
		str = str.."@"
	end
	
	str = sub(str,1,#str-1)
	
	printh(str,"@clip")
	
end

--@shiftalow / bitchunk
function tohex(v,d)
v=sub(tostr(tonum(v),1),3,6)
while v[1]=='0' and #v>(d or 0) do
v=sub(v,2)
end
return v
end


function string_to_sheet(string)
	local x,y,i,outputstring = 0,52,1,""
	while i < #string do
		
		local col1,col2 =
		ord(tostr(sub(string,i,i)))&0x0f,
		(ord(tostr(sub(string,i,i)))&0xf0)>>4
		
		sset(x,y,col1)
		sset(x+1,y,col2)
		outputstring = outputstring..tohex(col1)..tohex(col2)
		
		x += 2
		if x >= 128 then
			x = 0
			y += 1
		end
		
		i+=1
		
	end
	
	spr(128,0,0,16,3)
	cstore()
	--printh("[gfx]8010"..outputstring.."[/gfx]","@clip")
end

