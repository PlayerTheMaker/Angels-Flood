txt ="100|100|c1|This is a test!\nAnd we love tests\nhere!#".."64|64|c2|more text#".."100|128|c3|wowie#".."@0|32|i6c0|All living beings are\nmy pawns.#".."24|56|i6c0|Even Purity...\nEspecially Purity#".."32|60|i6c0|She saw my motives\nas aligned with hers.\nMistakenly.#".."40|56|i6c0|Nothing can be impure\nif nothing exists,#".."43|48|i6c0|but nothing can be\npure if nothing\nexists.#".."46|38|i6c0|Yet, she almost\nfulfilled me. I was\nalmost at peace.#".."54|36|i6c0|Yet, a single being,\nborn of primitive form,\npersisted.#".."66|38|i6c0|All living beings are\nmy pawns. But this\nlittle pyramid,#".."80|46|i6c0|It salvaged the\nsword of creation.#".."100|59|i6c0|And so my struggle\nbegins anew.#".."@67|57|i7a1|\fcThis is it. All the\nworld's water.#".."67|57|i7a1|\fcFrom the skies to\nthe currents to\nthe earth itself.#".."30|50|i0g1|Well done, \fcScrubs\f7.\nI am proud...#".."30|50|i0g1|You know what comes\nnext.#".."67|57|i7a1|\fcYes, \f7Purity\fc.#".."104|50|i7e1|\ffI'll miss you, \fcScrubs\ff.#".."67|57|i7a1|\fcAnd I you, \ffScorch\fc.#".."!|-.1,2|.1,2|0,2#".."67|57|i7a1|\fcOh!\nWhat's this?#".."67|57|i7a1|\fcA primitive form,\nbrought to life?#".."104|50|i7e1|\ffIt's exeptionally\npure...#".."30|50|i0g1|But not perfectly so.\nNothing is anymore...#".."30|50|i0g1|I wished to see \fcyou\f7\noff, but as \ffScorch\f7 &\nI must be going,#".."!|-.25,2|.1,2|.2,2#".."30|50|i0g1|It is \fcyour\f7 duty to\nwash away this final\nform.#".."30|50|i0g1|Still, I must take a\n\fcwing\f7. You understand,\nI hope.#".."67|57|i7a1|\fc...I do. Goodbye,\n\f7Purity.#".."!|-.25,2|.1,2|.2,1#".."30|50|i1c1|Goodbye.#".."!|-.25,3|.1,2|.2,1#".."104|50|i7e1|\ff...How indecent.#".."104|50|i7e1|\ffFarewell, \fcScrubs.#".."!|-.25,3|.1,3|0,1#".."67|57|i7a1|\fc...#".."67|57|i7a1|\fcMy last Goodbye.\n\nwill be to \f8you\fc.#"

speech_convos = {}
convos = split(dialogue,"@")
for convo in all(convos) do
 local tempconvo = split(convo,"#")
 add(speech_convos,tempconvo)
end]]

dialogue = {
	
	--lvl 1
	{
	"67|57|i7a1|\fcThis is it. All the\nworld's water.",
